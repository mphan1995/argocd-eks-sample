JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=*INPUT THE PASSWORD. THIS IS NOT LEAK*
JENKINS_JAVA_OPTS=-Djenkins.install.runSetupWizard=false -Xms256m -Xmx1024m
NEXUS_JAVA_OPTS=-Xms256m -Xmx1024m -Djava.util.prefs.userRoot=/nexus-data/javaprefs
REGISTRY_URL=localhost:5000
IMAGE_NAME=sample-app
TAG=local
KIND_CLUSTER_NAME=local-max
DEPLOY_NAME_PREFIX=devops-production
UI_BIND=127.0.0.1
UI_PORT=5001
UI_TOKEN=
DOCKER_GID=999
STRICT_TESTS=false
TRIVY_SEVERITY=CRITICAL,HIGH
TRIVY_TIMEOUT=5m
TRIVY_SKIP_DB_UPDATE=true
INSTALL_DIR=
ENABLE_NEXUS=false
